<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= brand.name %> | Control</title>
    <link rel="icon" type="image/png" href="<%= brand.faviconPath %>" />
    <% (clientAssets?.css || []).forEach((href) => { %>
      <link rel="stylesheet" href="<%= href %>" />
    <% }) %>
    <script>
      window.CSRF_TOKEN = "<%= csrfToken %>";
    </script>
    <% (clientAssets?.js || []).forEach((src) => { %>
      <script src="<%= src %>" type="module"></script>
    <% }) %>
  </head>
  <body class="min-h-screen bg-black text-zinc-100 antialiased">
    <main class="min-h-screen">
      <section class="border-b border-zinc-800">
        <div class="mx-auto flex max-w-[1800px] items-start justify-between gap-6 px-5 py-5">
          <div class="flex items-start gap-4">
            <img src="<%= brand.logoPath %>" alt="<%= brand.name %> logo" class="h-16 w-16 rounded-2xl border border-lime-500/40 bg-zinc-950 object-cover p-1" />
            <div>
              <p class="text-xs uppercase tracking-[0.34em] text-lime-400/80">War Room</p>
              <h1 class="mt-2 text-4xl font-semibold text-zinc-50"><%= brand.name %></h1>
            </div>
          </div>
          <div class="ml-auto">
            <p class="mt-3 max-w-xl text-sm leading-6 text-zinc-400">
              Preview hosts muster at
              <code class="text-zinc-300">{repoSlug}-{deploymentKey}.<%= baseDomain %></code>
              for PR and branch targets.
            </p>
          </div>
          <form method="post" action="/logout">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="border border-zinc-800 bg-zinc-900 px-4 py-2 text-sm text-zinc-100 transition hover:bg-zinc-800">
              Sign out
            </button>
          </form>
        </div>
        <div class="mx-auto max-w-[1800px] px-5 pb-4">
          <p class="text-sm text-zinc-300" data-ui-status><%= statusMessage || "" %></p>
        </div>
      </section>

      <%- include("partials/repo-config") %>

      <section class="border-t border-zinc-800">
        <div class="mx-auto max-w-[1800px] px-5 py-5">
          <div class="mb-6">
            <p class="text-xs uppercase tracking-[0.34em] text-zinc-500">Runtime</p>
            <h2 class="mt-3 text-4xl font-semibold text-zinc-50">Preview runtime details</h2>
            <p class="mt-4 max-w-4xl text-sm leading-7 text-zinc-400">
              Use repo-owned Traefik labels, or let the orchestrator append them. Deployment logs, compose contract details, and runtime history are shown below for webhook-driven PR previews and manual targets.
            </p>
          </div>

          <div class="grid gap-6 xl:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)]">
            <section class="space-y-6">
              <div class="border border-zinc-800 bg-zinc-950/70 px-5 py-5">
                <p class="mb-3 text-xs uppercase tracking-[0.34em] text-zinc-500">GitHub App</p>
                <p class="mb-4 text-sm leading-6 text-zinc-400">Create a preconfigured GitHub App, install it on selected repositories, then refresh access when you add more repositories later.</p>
                <% if (!githubApp) { %>
                  <form method="post" action="/api/github-app/manifest">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <div class="mb-4 space-y-2">
                      <label for="organizationLogin" class="block text-xs uppercase tracking-[0.28em] text-zinc-500">Organization Owner</label>
                      <input
                        id="organizationLogin"
                        name="organizationLogin"
                        placeholder="leave blank for your personal account"
                        class="w-full border border-zinc-800 bg-zinc-900 px-4 py-3 text-sm text-zinc-100 outline-none transition focus:border-zinc-600"
                      />
                      <p class="text-xs leading-5 text-zinc-500">Leave this empty to create the app under your personal account, or enter an organization login to create the app under that organization instead.</p>
                    </div>
                    <button
                      type="submit"
                      class="mb-4 border border-zinc-700 bg-zinc-100 px-4 py-3 text-left text-sm font-medium text-black transition hover:bg-zinc-300"
                    >
                      Create GitHub App
                    </button>
                  </form>
                  <p class="text-sm leading-6 text-zinc-400">No GitHub App has been created yet.</p>
                <% } else { %>
                  <div class="mb-4 space-y-2 text-sm text-zinc-300">
                    <div>Name: <code><%= githubApp.name || brand.name %></code></div>
                    <div>Slug: <code><%= githubApp.slug %></code></div>
                    <div>App ID: <code><%= githubApp.appId %></code></div>
                    <div>Owner: <code><%= githubApp.ownerLogin || "personal" %></code></div>
                  </div>
                  <div class="mb-4 flex flex-wrap gap-3">
                    <% if (githubAppInstallUrl) { %>
                      <a
                        href="<%= githubAppInstallUrl %>"
                        target="_blank"
                        rel="noreferrer"
                        class="border border-zinc-700 bg-zinc-100 px-4 py-3 text-sm font-medium text-black transition hover:bg-zinc-300"
                      >
                        Open installation flow
                      </a>
                    <% } %>
                    <% if (githubAppSettingsUrl) { %>
                      <a
                        href="<%= githubAppSettingsUrl %>"
                        target="_blank"
                        rel="noreferrer"
                        class="border border-zinc-700 bg-zinc-900 px-4 py-3 text-sm font-medium text-zinc-100 transition hover:bg-zinc-800"
                      >
                        Open app settings
                      </a>
                    <% } %>
                    <button
                      type="button"
                      data-api-action
                      data-method="POST"
                      data-action="/api/github-app/installations/refresh"
                      class="border border-zinc-700 bg-zinc-900 px-4 py-3 text-sm font-medium text-zinc-100 transition hover:bg-zinc-800"
                    >
                      Refresh GitHub access
                    </button>
                  </div>
                  <div class="mb-4 border border-zinc-800 bg-black/40 px-4 py-4">
                    <div class="flex flex-wrap items-center gap-4">
                      <img src="<%= brand.faviconPath %>" alt="<%= brand.name %> app badge" class="h-14 w-14 rounded-2xl border border-zinc-800 bg-zinc-950 p-2 object-contain" />
                      <div class="min-w-0">
                        <p class="text-sm font-medium text-zinc-100">App badge source</p>
                        <p class="mt-1 text-xs leading-5 text-zinc-500">GitHub does not let the manifest flow set the app badge. Use the favicon below when GitHub prompts you to upload a logo in the app settings page.</p>
                        <div class="mt-3 flex flex-wrap gap-3">
                          <a href="<%= brand.faviconPath %>" target="_blank" rel="noreferrer" class="text-sm text-zinc-300 underline decoration-zinc-700 underline-offset-4">
                            Open favicon image
                          </a>
                          <% if (githubAppSettingsUrl) { %>
                            <a href="<%= githubAppSettingsUrl %>" target="_blank" rel="noreferrer" class="text-sm text-zinc-300 underline decoration-zinc-700 underline-offset-4">
                              Upload logo on GitHub
                            </a>
                          <% } %>
                        </div>
                      </div>
                    </div>
                  </div>
                  <% if ((githubApp.installations || []).length) { %>
                    <div class="space-y-3">
                      <% githubApp.installations.forEach((installation) => { %>
                        <div class="border border-zinc-800 bg-black/40 px-4 py-4">
                          <div class="flex flex-wrap items-center justify-between gap-3">
                            <div>
                              <p class="text-sm font-medium text-zinc-100"><%= installation.accountLogin || `installation-${installation.id}` %></p>
                              <p class="mt-1 text-xs uppercase tracking-[0.24em] text-zinc-500">
                                <%= installation.repositorySelection || "selected" %> · <%= (installation.repositories || []).length %> repos
                              </p>
                            </div>
                            <% if (installation.htmlUrl) { %>
                              <a
                                href="<%= installation.htmlUrl %>"
                                target="_blank"
                                rel="noreferrer"
                                class="border border-zinc-700 bg-zinc-900 px-3 py-2 text-sm font-medium text-zinc-100 transition hover:bg-zinc-800"
                              >
                                Configure repo access
                              </a>
                            <% } %>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <p class="text-sm leading-6 text-zinc-400">App created. Install it on selected repositories, then refresh GitHub access here.</p>
                  <% } %>
                <% } %>
              </div>

              <div class="border border-zinc-800 bg-zinc-950/70 px-5 py-5">
                <p class="mb-3 text-xs uppercase tracking-[0.34em] text-zinc-500">Compose Contract</p>
                <pre class="overflow-x-auto border border-zinc-800 bg-[#050505] px-4 py-4 text-xs leading-6 text-zinc-200">services:
  app:
    networks:
      - default
      - preview-proxy
    labels:
      - traefik.enable=true
      - traefik.docker.network=<%= traefikNetworkName %>
      - traefik.http.routers.${ORCH_PROJECT_NAME}.rule=Host(`${ORCH_PREVIEW_HOST}`)
      - traefik.http.routers.${ORCH_PROJECT_NAME}.entrypoints=web
      - traefik.http.services.${ORCH_PROJECT_NAME}.loadbalancer.server.port=${ORCH_PREVIEW_SERVICE_PORT}

networks:
  preview-proxy:
    external: true
    name: <%= traefikNetworkName %></pre>
              </div>

              <div class="border border-zinc-800 bg-zinc-950/70 px-5 py-5">
                <p class="mb-3 text-xs uppercase tracking-[0.34em] text-zinc-500">App Log Tail</p>
                <p class="mb-4 text-sm leading-6 text-zinc-400">Append-only operator log from <code class="text-zinc-300">data/logs/app.log</code>.</p>
                <pre class="overflow-x-auto border border-zinc-800 bg-[#050505] px-4 py-4 text-xs leading-6 text-zinc-200"><%= appLogTail || "No events logged yet." %></pre>
              </div>
            </section>

            <%- include("partials/deployments-panel") %>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
